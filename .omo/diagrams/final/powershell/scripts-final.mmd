graph TD
    %% Nodes Styling
    classDef module fill:#f9f,stroke:#333,stroke-width:2px;
    classDef script fill:#fdf,stroke:#333,stroke-width:2px;
    classDef function fill:#bbf,stroke:#333,stroke-width:1px;
    classDef data fill:#dfd,stroke:#333,stroke-width:1px;

    subgraph ProfileSection [Profile & Entry]
        Profile[Microsoft.PowerShell_profile.ps1]:::script
        Profile -- "Import-Module" --> ToolkitMod
        Profile -- "Import-Module" --> AgentChatsMod
    end

    subgraph ModulesSection [PowerShell Modules]
        subgraph ToolkitMod [ScriptsToolkit Module]
            ToolkitPSM1[ScriptsToolkit.psm1]:::module
            ToolkitPSD1[ScriptsToolkit.psd1]:::module
            
            AssertNet["Assert-NetworkAvailable()"]:::function
            AssertCmd["Assert-CommandExists([string]$Command)"]:::function
            TestSrt["Test-SrtExists([string]$FilePath)"]:::function
            GetMedia["Get-MediaFiles([System.IO.DirectoryInfo]$Directory)"]:::function
            
            ToolkitPSM1 --> AssertNet
            ToolkitPSM1 --> AssertCmd
            ToolkitPSM1 --> TestSrt
            ToolkitPSM1 --> GetMedia
        end

        subgraph AgentChatsMod [AgentChats Module]
            AgentChatsPSM1[AgentChats.psm1]:::module
            AgentChatsPSD1[AgentChats.psd1]:::module
            
            ExportAgentChatsFunc["Export-AgentChats([string]$Agent, [string]$OutputDir)"]:::function
            NewSessionIdFunc["New-SessionId()"]:::function
            WriteChatJsonFunc["_Write-ChatJson([string]$Path, [object]$SessionObj)"]:::function
            
            AgentChatsPSM1 --> ExportAgentChatsFunc
            ExportAgentChatsFunc --> NewSessionIdFunc
            ExportAgentChatsFunc --> WriteChatJsonFunc
        end
    end

    subgraph ScriptsSection [Standalone Scripts]
        InstallEnv[Install-Env.ps1]:::script
        InstallEnv -- "Import-Module" --> ToolkitMod
        InstallEnv -- "Uses" --> Winget[Winget]:::data
        InstallEnv -- "Uses" --> VSCode[VS Code CLI]:::data
    end

    %% Cross-Module Dependencies
    AgentChatsMod -- "Uses" --> ToolkitMod

    %% Data Flows
    ExportAgentChatsFunc -- "Output: .json files" --> ChatJSON[Chat JSON Files]:::data
    InstallEnv -- "Output: System Env" --> SystemEnv[System Environment]:::data
