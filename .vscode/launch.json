{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch C# CLI",
			"type": "coreclr",
			"request": "launch",
			"program": "${workspaceFolder}/csharp/publish/tools.exe",
			"args": [],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"preLaunchTask": "build"
		},
		{
			"name": "Debug C# CLI",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${workspaceFolder}/csharp/bin/Debug/net11.0/tools.dll",
			"args": [],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal"
		}
	]
}
