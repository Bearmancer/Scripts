# Cross-platform line endings: normalize to LF in repo, checkout as-is on all platforms
* text=auto eol=lf

# Force LF for C# and related source files
*.cs text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.sln text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.psm1 text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.env text eol=lf
*.editorconfig text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.xml text eol=lf
*.config text eol=lf

# True binaries — no text processing
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.dll binary
*.exe binary
*.pdb binary
*.nupkg binary
