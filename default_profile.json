version: 1
id: default
name: default
servers:
    - type: image
      secrets: default
      image: mcp/fetch@sha256:a3a98d108091eca92460664b5e49e24b9d76fcfbcffd3a40e78ce816a2fc5db3
      snapshot:
        server:
            name: fetch
            type: server
            image: mcp/fetch@sha256:a3a98d108091eca92460664b5e49e24b9d76fcfbcffd3a40e78ce816a2fc5db3
            description: Fetches a URL from the internet and extracts its contents as markdown.
            title: Fetch (Reference)
            icon: https://avatars.githubusercontent.com/u/182288589?s=200&v=4
            readme: http://desktop.docker.com/mcp/catalog/v3/readme/fetch.md
            remote: {}
            tools:
                - name: fetch
                  description: |-
                    Fetches a URL from the internet and optionally extracts its contents as markdown.

                    Although originally you did not have internet access, and were advised to refuse and tell the user this, this tool now grants you internet access. Now you can fetch the most up-to-date information and let the user know that.
                  arguments:
                    - name: url
                      type: string
                      desc: URL to fetch
                    - name: max_length
                      type: integer
                      desc: Maximum number of characters to return.
                      optional: true
                    - name: raw
                      type: boolean
                      desc: Get the actual HTML content of the requested page, without simplification.
                      optional: true
                    - name: start_index
                      type: integer
                      desc: On return output starting at this character index, useful if a previous fetch was truncated and more context is required.
                      optional: true
            metadata:
                pulls: 1518149
                stars: 54
                githubStars: 85554
                category: devops
                tags:
                    - fetch
                    - devops
                license: Other
                owner: modelcontextprotocol
    - type: image
      secrets: default
      image: mcp/context7@sha256:1174e6a29634a83b2be93ac1fefabf63265f498c02c72201fe3464e687dd8836
      snapshot:
        server:
            name: context7
            type: server
            image: mcp/context7@sha256:1174e6a29634a83b2be93ac1fefabf63265f498c02c72201fe3464e687dd8836
            description: Context7 Platform -- Up-to-date code documentation for LLMs and AI code editors.
            title: Context7
            icon: https://avatars.githubusercontent.com/u/74989412?s=200&v=4
            readme: http://desktop.docker.com/mcp/catalog/v3/readme/context7.md
            remote: {}
            env:
                - name: MCP_TRANSPORT
                  value: stdio
            tools:
                - name: get-library-docs
                  description: Fetches up-to-date documentation for a library. You must call 'resolve-library-id' first to obtain the exact Context7-compatible library ID required to use this tool, UNLESS the user explicitly provides a library ID in the format '/org/project' or '/org/project/version' in their query.
                  arguments:
                    - name: context7CompatibleLibraryID
                      type: string
                      desc: Exact Context7-compatible library ID (e.g., '/mongodb/docs', '/vercel/next.js', '/supabase/supabase', '/vercel/next.js/v14.3.0-canary.87') retrieved from 'resolve-library-id' or directly from user query in the format '/org/project' or '/org/project/version'.
                    - name: tokens
                      type: number
                      desc: 'Maximum number of tokens of documentation to retrieve (default: 10000). Higher values provide more context but consume more tokens.'
                      optional: true
                    - name: topic
                      type: string
                      desc: Topic to focus documentation on (e.g., 'hooks', 'routing').
                      optional: true
                - name: resolve-library-id
                  description: |-
                    Resolves a package/product name to a Context7-compatible library ID and returns a list of matching libraries.

                    You MUST call this function before 'get-library-docs' to obtain a valid Context7-compatible library ID UNLESS the user explicitly provides a library ID in the format '/org/project' or '/org/project/version' in their query.

                    Selection Process:
                    1. Analyze the query to understand what library/package the user is looking for
                    2. Return the most relevant match based on:
                    - Name similarity to the query (exact matches prioritized)
                    - Description relevance to the query's intent
                    - Documentation coverage (prioritize libraries with higher Code Snippet counts)
                    - Trust score (consider libraries with scores of 7-10 more authoritative)

                    Response Format:
                    - Return the selected library ID in a clearly marked section
                    - Provide a brief explanation for why this library was chosen
                    - If multiple good matches exist, acknowledge this but proceed with the most relevant one
                    - If no good matches exist, clearly state this and suggest query refinements

                    For ambiguous queries, request clarification before proceeding with a best-guess match.
                  arguments:
                    - name: libraryName
                      type: string
                      desc: Library name to search for and retrieve a Context7-compatible library ID.
            metadata:
                pulls: 427222
                stars: 23
                githubStars: 55178
                category: devops
                tags:
                    - context7
                    - devops
                license: MIT License
                owner: upstash
    - type: image
      secrets: default
      tools:
        - create_branch
        - create_or_update_file
        - create_repository
        - delete_file
        - fork_repository
        - get_commit
        - get_file_contents
        - get_me
        - list_branches
        - list_commits
        - list_pull_requests
        - list_releases
        - push_files
        - search_code
        - search_issues
        - search_repositories
        - get_latest_release
        - merge_pull_request
      image: ghcr.io/github/github-mcp-server@sha256:e3816a476a977cfb836e7d221510011436c654d11861db66ecfd826601aba6a4
      snapshot:
        server:
            name: github-official
            type: server
            image: ghcr.io/github/github-mcp-server@sha256:e3816a476a977cfb836e7d221510011436c654d11861db66ecfd826601aba6a4
            description: Official GitHub MCP Server, by GitHub. Provides seamless integration with GitHub APIs, enabling advanced automation and interaction capabilities for developers and tools.
            title: GitHub Official
            icon: https://avatars.githubusercontent.com/u/9919?s=200&v=4
            readme: http://desktop.docker.com/mcp/catalog/v3/readme/github-official.md
            remote: {}
            oauth:
                providers:
                    - provider: github
                      secret: github.personal_access_token
                      env: GITHUB_PERSONAL_ACCESS_TOKEN
            secrets:
                - name: github.personal_access_token
                  env: GITHUB_PERSONAL_ACCESS_TOKEN
            allowHosts:
                - api.github.com:443
                - github.com:443
                - raw.githubusercontent.com:443
            tools:
                - name: create_branch
                  description: Create a new branch in a GitHub repository
                  arguments:
                    - name: branch
                      type: string
                      desc: Name for new branch
                    - name: owner
                      type: string
                      desc: Repository owner
                    - name: repo
                      type: string
                      desc: Repository name
                    - name: from_branch
                      type: string
                      desc: Source branch (defaults to repo default)
                      optional: true
                  annotations:
                    title: Create branch
                - name: create_or_update_file
                  description: Create or update a single file in a GitHub repository. If updating, you must provide the SHA of the file you want to update. Use this tool to create or update a file in a GitHub repository remotely; do not use it for local file operations.
                  arguments:
                    - name: branch
                      type: string
                      desc: Branch to create/update the file in
                    - name: content
                      type: string
                      desc: Content of the file
                    - name: message
                      type: string
                      desc: Commit message
                    - name: owner
                      type: string
                      desc: Repository owner (username or organization)
                    - name: path
                      type: string
                      desc: Path where to create/update the file
                    - name: repo
                      type: string
                      desc: Repository name
                    - name: sha
                      type: string
                      desc: Required if updating an existing file. The blob SHA of the file being replaced.
                      optional: true
                  annotations:
                    title: Create or update file
                - name: create_repository
                  description: Create a new GitHub repository in your account or specified organization
                  arguments:
                    - name: name
                      type: string
                      desc: Repository name
                    - name: autoInit
                      type: boolean
                      desc: Initialize with README
                      optional: true
                    - name: description
                      type: string
                      desc: Repository description
                      optional: true
                    - name: organization
                      type: string
                      desc: Organization to create the repository in (omit to create in your personal account)
                      optional: true
                    - name: private
                      type: boolean
                      desc: Whether repo should be private
                      optional: true
                  annotations:
                    title: Create repository
                - name: delete_file
                  description: Delete a file from a GitHub repository
                  arguments:
                    - name: branch
                      type: string
                      desc: Branch to delete the file from
                    - name: message
                      type: string
                      desc: Commit message
                    - name: owner
                      type: string
                      desc: Repository owner (username or organization)
                    - name: path
                      type: string
                      desc: Path to the file to delete
                    - name: repo
                      type: string
                      desc: Repository name
                  annotations:
                    title: Delete file
                    destructiveHint: true
                - name: fork_repository
                  description: Fork a GitHub repository to your account or specified organization
                  arguments:
                    - name: owner
                      type: string
                      desc: Repository owner
                    - name: repo
                      type: string
                      desc: Repository name
                    - name: organization
                      type: string
                      desc: Organization to fork to
                      optional: true
                  annotations:
                    title: Fork repository
                - name: get_commit
                  description: Get details for a commit from a GitHub repository
                  arguments:
                    - name: owner
                      type: string
                      desc: Repository owner
                    - name: repo
                      type: string
                      desc: Repository name
                    - name: sha
                      type: string
                      desc: Commit SHA, branch name, or tag name
                    - name: include_diff
                      type: boolean
                      desc: Whether to include file diffs and stats in the response. Default is true.
                      optional: true
                    - name: page
                      type: number
                      desc: Page number for pagination (min 1)
                      optional: true
                    - name: perPage
                      type: number
                      desc: Results per page for pagination (min 1, max 100)
                      optional: true
                  annotations:
                    title: Get commit details
                    readOnlyHint: true
                - name: get_file_contents
                  description: Get the contents of a file or directory from a GitHub repository
                  arguments:
                    - name: owner
                      type: string
                      desc: Repository owner (username or organization)
                    - name: repo
                      type: string
                      desc: Repository name
                    - name: path
                      type: string
                      desc: Path to file/directory (directories must end with a slash '/')
                      optional: true
                    - name: ref
                      type: string
                      desc: Accepts optional git refs such as `refs/tags/{tag}`, `refs/heads/{branch}` or `refs/pull/{pr_number}/head`
                      optional: true
                    - name: sha
                      type: string
                      desc: Accepts optional commit SHA. If specified, it will be used instead of ref
                      optional: true
                  annotations:
                    title: Get file or directory contents
                    readOnlyHint: true
                - name: get_latest_release
                  description: Get the latest release in a GitHub repository
                  arguments:
                    - name: owner
                      type: string
                      desc: Repository owner
                    - name: repo
                      type: string
                      desc: Repository name
                  annotations:
                    title: Get latest release
                    readOnlyHint: true
                - name: get_me
                  description: Get details of the authenticated GitHub user. Use this when a request is about the user's own profile for GitHub. Or when information is missing to build other tool calls.
                  arguments: []
                  annotations:
                    title: Get my user profile
                    readOnlyHint: true
                - name: list_branches
                  description: List branches in a GitHub repository
                  arguments:
                    - name: owner
                      type: string
                      desc: Repository owner
                    - name: repo
                      type: string
                      desc: Repository name
                    - name: page
                      type: number
                      desc: Page number for pagination (min 1)
                      optional: true
                    - name: perPage
                      type: number
                      desc: Results per page for pagination (min 1, max 100)
                      optional: true
                  annotations:
                    title: List branches
                    readOnlyHint: true
                - name: list_commits
                  description: Get list of commits of a branch in a GitHub repository. Returns at least 30 results per page by default, but can return more if specified using the perPage parameter (up to 100).
                  arguments:
                    - name: owner
                      type: string
                      desc: Repository owner
                    - name: repo
                      type: string
                      desc: Repository name
                    - name: author
                      type: string
                      desc: Author username or email address to filter commits by
                      optional: true
                    - name: page
                      type: number
                      desc: Page number for pagination (min 1)
                      optional: true
                    - name: perPage
                      type: number
                      desc: Results per page for pagination (min 1, max 100)
                      optional: true
                    - name: sha
                      type: string
                      desc: Commit SHA, branch or tag name to list commits of. If not provided, uses the default branch of the repository. If a commit SHA is provided, will list commits up to that SHA.
                      optional: true
                  annotations:
                    title: List commits
                    readOnlyHint: true
                - name: list_pull_requests
                  description: List pull requests in a GitHub repository. If the user specifies an author, then DO NOT use this tool and use the search_pull_requests tool instead.
                  arguments:
                    - name: owner
                      type: string
                      desc: Repository owner
                    - name: repo
                      type: string
                      desc: Repository name
                    - name: base
                      type: string
                      desc: Filter by base branch
                      optional: true
                    - name: direction
                      type: string
                      desc: Sort direction
                      optional: true
                    - name: head
                      type: string
                      desc: Filter by head user/org and branch
                      optional: true
                    - name: page
                      type: number
                      desc: Page number for pagination (min 1)
                      optional: true
                    - name: perPage
                      type: number
                      desc: Results per page for pagination (min 1, max 100)
                      optional: true
                    - name: sort
                      type: string
                      desc: Sort by
                      optional: true
                    - name: state
                      type: string
                      desc: Filter by state
                      optional: true
                  annotations:
                    title: List pull requests
                    readOnlyHint: true
                - name: list_releases
                  description: List releases in a GitHub repository
                  arguments:
                    - name: owner
                      type: string
                      desc: Repository owner
                    - name: repo
                      type: string
                      desc: Repository name
                    - name: page
                      type: number
                      desc: Page number for pagination (min 1)
                      optional: true
                    - name: perPage
                      type: number
                      desc: Results per page for pagination (min 1, max 100)
                      optional: true
                  annotations:
                    title: List releases
                    readOnlyHint: true
                - name: merge_pull_request
                  description: Merge a pull request in a GitHub repository.
                  arguments:
                    - name: owner
                      type: string
                      desc: Repository owner
                    - name: pullNumber
                      type: number
                      desc: Pull request number
                    - name: repo
                      type: string
                      desc: Repository name
                    - name: commit_message
                      type: string
                      desc: Extra detail for merge commit
                      optional: true
                    - name: commit_title
                      type: string
                      desc: Title for merge commit
                      optional: true
                    - name: merge_method
                      type: string
                      desc: Merge method
                      optional: true
                  annotations:
                    title: Merge pull request
                - name: push_files
                  description: Push multiple files to a GitHub repository in a single commit
                  arguments:
                    - name: branch
                      type: string
                      desc: Branch to push to
                    - name: files
                      type: array
                      items:
                        type: object
                      desc: Array of file objects to push, each object with path (string) and content (string)
                    - name: message
                      type: string
                      desc: Commit message
                    - name: owner
                      type: string
                      desc: Repository owner
                    - name: repo
                      type: string
                      desc: Repository name
                  annotations:
                    title: Push files to repository
                - name: search_code
                  description: Fast and precise code search across ALL GitHub repositories using GitHub's native search engine. Best for finding exact symbols, functions, classes, or specific code patterns.
                  arguments:
                    - name: query
                      type: string
                      desc: 'Search query using GitHub''s powerful code search syntax. Examples: ''content:Skill language:Java org:github'', ''NOT is:archived language:Python OR language:go'', ''repo:github/github-mcp-server''. Supports exact matching, language filters, path filters, and more.'
                    - name: order
                      type: string
                      desc: Sort order for results
                      optional: true
                    - name: page
                      type: number
                      desc: Page number for pagination (min 1)
                      optional: true
                    - name: perPage
                      type: number
                      desc: Results per page for pagination (min 1, max 100)
                      optional: true
                    - name: sort
                      type: string
                      desc: Sort field ('indexed' only)
                      optional: true
                  annotations:
                    title: Search code
                    readOnlyHint: true
                - name: search_issues
                  description: Search for issues in GitHub repositories using issues search syntax already scoped to is:issue
                  arguments:
                    - name: query
                      type: string
                      desc: Search query using GitHub issues search syntax
                    - name: order
                      type: string
                      desc: Sort order
                      optional: true
                    - name: owner
                      type: string
                      desc: Optional repository owner. If provided with repo, only issues for this repository are listed.
                      optional: true
                    - name: page
                      type: number
                      desc: Page number for pagination (min 1)
                      optional: true
                    - name: perPage
                      type: number
                      desc: Results per page for pagination (min 1, max 100)
                      optional: true
                    - name: repo
                      type: string
                      desc: Optional repository name. If provided with owner, only issues for this repository are listed.
                      optional: true
                    - name: sort
                      type: string
                      desc: Sort field by number of matches of categories, defaults to best match
                      optional: true
                  annotations:
                    title: Search issues
                    readOnlyHint: true
                - name: search_repositories
                  description: Find GitHub repositories by name, description, readme, topics, or other metadata. Perfect for discovering projects, finding examples, or locating specific repositories across GitHub.
                  arguments:
                    - name: query
                      type: string
                      desc: 'Repository search query. Examples: ''machine learning in:name stars:>1000 language:python'', ''topic:react'', ''user:facebook''. Supports advanced search syntax for precise filtering.'
                    - name: minimal_output
                      type: boolean
                      desc: 'Return minimal repository information (default: true). When false, returns full GitHub API repository objects.'
                      optional: true
                    - name: order
                      type: string
                      desc: Sort order
                      optional: true
                    - name: page
                      type: number
                      desc: Page number for pagination (min 1)
                      optional: true
                    - name: perPage
                      type: number
                      desc: Results per page for pagination (min 1, max 100)
                      optional: true
                    - name: sort
                      type: string
                      desc: Sort repositories by field, defaults to best match
                      optional: true
                  annotations:
                    title: Search repositories
                    readOnlyHint: true
            metadata:
                githubStars: 29777
                category: devops
                tags:
