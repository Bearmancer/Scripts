                      type: string
                      desc: ""
                    - name: options
                      type: object
                      desc: ""
                      optional: true
                    - name: outputPath
                      type: string
                      desc: ""
                      optional: true
                  annotations:
                    title: Write/Modify PDF
                    readOnlyHint: false
                    destructiveHint: true
                    openWorldHint: false
